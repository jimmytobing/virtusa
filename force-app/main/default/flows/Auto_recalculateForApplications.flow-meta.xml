    <description
  >Recalculate unpaid disbursements for one Contact (varR_Contact: Id and proposed Support_Option__c). Count paid months with Assignment, sum paid amounts in one loop, then validate before replacing unpaid schedules. Return business errors in varT_Error.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_ReceivedAmount</name>
        <dataType>Currency</dataType>
        <expression
    >BLANKVALUE({!Loop_Disbursements.Amount_to_be_disbursed__c}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>f_NewTotal</name>
        <dataType>Currency</dataType>
        <expression
    >{!Get_Support_Option.Amount__c} * {!Get_Support_Option.Duration__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>f_RemainingAmount</name>
        <dataType>Currency</dataType>
        <expression>{!f_NewTotal} - {!varN_TotalReceived}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>f_RemainingMonths</name>
        <dataType>Number</dataType>
        <expression
    >{!Get_Support_Option.Duration__c} - {!varN_ReceivedMonths}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_MonthlyAmount</name>
        <dataType>Currency</dataType>
        <expression>{!f_RemainingAmount} / {!f_RemainingMonths}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>f_FirstNextMonth</name>
        <dataType>Date</dataType>
        <expression
    >ADDMONTHS(DATE(YEAR({!$Flow.CurrentDate}), MONTH({!$Flow.CurrentDate}), 1), 1)</expression>
    </formulas>
    <formulas>
        <name>f_DisbursementDate</name>
        <dataType>Date</dataType>
        <expression
    >ADDMONTHS({!f_FirstNextMonth}, {!varN_MonthNumber} - 1)</expression>
    </formulas>
    <formulas>
        <name>f_Sequence</name>
        <dataType>Number</dataType>
        <expression>{!varN_ReceivedMonths} + {!varN_MonthNumber}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_ErrorMessage</name>
        <dataType>String</dataType>
        <expression
    >IF(ISBLANK({!varT_ConfiguredMessage}), {!varT_DefaultMessage}, {!varT_ConfiguredMessage})</expression>
    </formulas>
    <interviewLabel
  >[Auto] recalculateForApplications {!$Flow.CurrentDateTime}</interviewLabel>
    <label>[Auto] recalculateForApplications</label>
