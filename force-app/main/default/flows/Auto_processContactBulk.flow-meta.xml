    <formulas>
        <name>Clean_Option</name>
        <dataType>String</dataType>
        <expression
    >LOWER(TRIM(SUBSTITUTE({!Get_Staging.SupportOptionRaw__c}, &quot;	&quot;, &quot; &quot;)))</expression>
    </formulas>
    <formulas>
        <name>Option_Amount</name>
        <dataType>Number</dataType>
        <expression
    >CASE({!Option_Number}, 1, 500, 2, 300, 3, 200, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>Option_Duration</name>
        <dataType>Number</dataType>
        <expression>CASE({!Option_Number}, 1, 3, 2, 6, 3, 12, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>Option_Number</name>
        <dataType>Number</dataType>
        <expression
    >CASE({!Clean_Option}, &quot;option 1&quot;, 1, &quot;option 1: sgd 500 per month for 3 months&quot;, 1, &quot;sgd 500 per month for 3 months&quot;, 1, &quot;sgd 500 for 3 months&quot;, 1, &quot;option 2&quot;, 2, &quot;option 2: sgd 300 per month for 6 months&quot;, 2, &quot;sgd 300 per month for 6 months&quot;, 2, &quot;sgd 300 for 6 months&quot;, 2, &quot;option 3&quot;, 3, &quot;option 3: sgd 200 per month for 12 months&quot;, 3, &quot;sgd 200 per month for 12 months&quot;, 3, &quot;sgd 200 for 12 months&quot;, 3, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>Valid_Input</name>
        <dataType>Boolean</dataType>
        <expression
    >AND(NOT(ISBLANK(TRIM({!Get_Staging.LastName__c}))), NOT(ISBLANK(TRIM({!Get_Staging.Phone__c}))), NOT(ISBLANK({!Get_Staging.MonthlyIncome__c})), {!Get_Staging.MonthlyIncome__c} &gt;= 0, {!Option_Number} &gt; 0)</expression>
    </formulas>
